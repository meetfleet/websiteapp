# ── Subdomain & Redirect Routing ──
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Redirect old /peer-review/ paths to research.meetfleet.org
  RewriteCond %{HTTP_HOST} !^research\.meetfleet\.org$ [NC]
  RewriteCond %{REQUEST_URI} ^/peer-review/?(.*)$ [NC]
  RewriteRule ^peer-review/?(.*)$ https://research.meetfleet.org/$1 [R=301,L]

  # Subdomain routing for research.meetfleet.org
  RewriteCond %{HTTP_HOST} ^research\.meetfleet\.(org|app)$ [NC]
  RewriteCond %{REQUEST_URI} !^/peer-review/
  RewriteRule ^(.*)$ /peer-review/$1 [L]
</IfModule>

# ── Compression ──
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

# ── Cache-Control ──
<IfModule mod_expires.c>
  ExpiresActive On

  # HTML — short TTL so deploys are picked up quickly
  ExpiresByType text/html                  "access plus 1 hour"

  # CSS & JS
  ExpiresByType text/css                   "access plus 1 year"
  ExpiresByType application/javascript     "access plus 1 year"

  # Fonts
  ExpiresByType font/ttf                   "access plus 1 year"
  ExpiresByType font/woff2                 "access plus 1 year"

  # Images
  ExpiresByType image/webp                 "access plus 1 year"
  ExpiresByType image/png                  "access plus 1 year"
  ExpiresByType image/svg+xml              "access plus 1 year"
</IfModule>

# ── Security headers ──
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
